{
  "dependencies": {
    "@types/node": "^22.8.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "express": "^4.21.1",
    "get-port": "^7.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-electron": "^0.28.8",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "name": "electron-vue-test",
  "version": "1.0.0",
  "main": "dist/CIB/electron/electron-main.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development concurrently \"vite --mode development\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "NODE_ENV=production_aws vue-tsc --noEmit && vite build --mode production_aws && electron-builder --dir",
    "build:frontend": "NODE_ENV=production_aws vue-tsc --noEmit && vite build --mode production_aws",
    "start": "electron .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.example.yourapp",
    "files": [
      "dist/CIB/**/*",
      "dist/CIB/electron/electron-main.js",
      "dist/CIB/electron/server.js"
    ],
    "directories": {
      "output": "dist/CIB"
    },
    "asarUnpack": [
      "dist/CIB/**/*/*.png",
      "dist/CIB/**/*/*.svg"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/express": "^5.0.0",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8"
  }
}
